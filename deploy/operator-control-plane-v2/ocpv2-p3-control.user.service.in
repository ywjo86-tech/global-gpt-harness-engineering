[Unit]
Description=OCPv2 bounded Lifecycle V2 P3 control poll
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@P3_CONTROL_SOURCE_ROOT@
Environment=OCP_HOST_INSPECTION_ENABLED=0
Environment=OCP_WORK_ACTIVATION_ENABLED=0
Environment=OCP_FULL_PLAN_ACTIVATION_ENABLED=0
Environment=OCP_SUCCESSOR_RELEASE_STAGE_ENABLED=0
Environment=OCP_LIFECYCLE_V2_P3_CANARY_ACTIVATION_ENABLED=0
Environment=GCH_NEW_ACTIVATION_LIFECYCLE_MODE=V2
EnvironmentFile=%h/.config/gch/ocpv2-p3-control.env
ExecStart=/usr/bin/python3 -m runtime.orchestrator.ocpv2_p3_control_runtime --env-file %h/.config/gch/ocpv2-p3-control.env
NoNewPrivileges=true
PrivateTmp=true
